# -------------------------------------------------------
# Copy this to .env and fill in values.
# -------------------------------------------------------

# Leave these blank to run in camera (mock) mode.
# Add your IVS-enabled IAM credentials to switch to Amazon IVS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# Change in production
SECRET_KEY=change-this-in-production

# Comma-separated allowed origins (* = all)
CORS_ORIGINS=*
