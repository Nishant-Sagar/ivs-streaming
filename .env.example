# Copy to .env and fill in your values

# AWS — IAM user needs: AmazonIVSFullAccess + ivschat:* permissions
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1

# JWT secret — run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Database
DATABASE_URL=sqlite:///./streaming.db

# CORS
CORS_ORIGINS=http://localhost:8080,http://localhost:3000
